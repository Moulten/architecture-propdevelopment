<mxfile host="app.diagrams.net" version="24.8.0">
  <diagram name="C4 Контекст — Умный дом PropDevelopment" id="smart-home-c4-context">
    <mxGraphModel dx="1800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== SYSTEM BOUNDARY ===== -->
        <mxCell id="boundary" value="PropDevelopment [Software System]" style="rounded=1;fontSize=13;whiteSpace=wrap;html=1;dashed=1;arcSize=3;fillColor=none;strokeColor=#444444;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;pointerEvents=0;connectable=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="220" width="1010" height="820" as="geometry"/>
        </mxCell>

        <!-- ===== MAIN SYSTEM BOX ===== -->
        <mxCell id="prop-system" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot;&gt;PropDevelopment&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#cccccc&quot;&gt;Платформа для продажи недвижимости и управления жилыми комплексами. Включает витрину продаж, онлайн-тур, онлайн-сделку и мобильное приложение для собственников.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;arcSize=5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="370" width="770" height="180" as="geometry"/>
        </mxCell>

        <!-- NEW smart home highlight -->
        <mxCell id="new-highlight" value="🆕 НОВЫЕ ФУНКЦИИ: Умный домофон + Умный шлагбаум&#xa;(биометрия лица / распознавание номеров авто)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="700" width="710" height="65" as="geometry"/>
        </mxCell>

        <!-- ===== PERSONS ===== -->
        <!-- Собственник -->
        <mxCell id="owner" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Собственник&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#cccccc&quot;&gt;Владелец жилья. Управляет умным домом, оплачивает ЖКУ и получает уведомления через мобильное приложение.&lt;/font&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- Клиент (покупатель) -->
        <mxCell id="client" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Клиент&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#cccccc&quot;&gt;Потенциальный покупатель. Подбирает жильё, записывается на осмотр и проводит онлайн-сделку.&lt;/font&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- Менеджер -->
        <mxCell id="manager" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Менеджер&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#cccccc&quot;&gt;Сотрудник PropDevelopment. Управляет клиентскими данными, объектами и онлайн-сделками.&lt;/font&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="200" height="180" as="geometry"/>
        </mxCell>

        <!-- ===== EXTERNAL SYSTEMS ===== -->
        <!-- Партнёр Умный дом [NEW] -->
        <mxCell id="smart-partner" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Партнёр «Умный дом»&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#ffffff&quot;&gt;🆕 НОВЫЙ. Платформа партнёра. Предоставляет API для интеллектуального домофона (распознавание лиц) и шлагбаума (распознавание номеров авто).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d3d3d;fontColor=#ffffff;strokeColor=#b85450;arcSize=5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="270" width="280" height="170" as="geometry"/>
        </mxCell>

        <!-- Поставщик ресурсов ЖКХ -->
        <mxCell id="jkh" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Поставщик ресурсов ЖКХ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#cccccc&quot;&gt;Системы управляющих компаний. Предоставляют данные о начислениях ЖКУ.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;arcSize=5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="500" width="280" height="140" as="geometry"/>
        </mxCell>

        <!-- Платёжная система -->
        <mxCell id="payment" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Платёжная система&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#cccccc&quot;&gt;Провайдер онлайн-платежей для оплаты ЖКУ собственниками.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;arcSize=5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="695" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- Госорганы -->
        <mxCell id="gov" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Государственные органы&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#cccccc&quot;&gt;Росреестр и др. Участвуют в регистрации онлайн-сделок с недвижимостью.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;arcSize=5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1620" y="880" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES ===== -->
        <!-- Собственник → PropDevelopment -->
        <mxCell id="e1" value="Управляет умным домофоном и шлагбаумом, оплачивает ЖКУ, просматривает информацию о ЖК [Mobile App, HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" source="owner" target="prop-system" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Клиент → PropDevelopment -->
        <mxCell id="e2" value="Подбирает и бронирует недвижимость, осматривает онлайн, проводит сделку [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" source="client" target="prop-system" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Менеджер → PropDevelopment -->
        <mxCell id="e3" value="Управляет данными клиентов, объектами и администрирует онлайн-сделки [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" source="manager" target="prop-system" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PropDevelopment → Партнёр Умный дом [NEW] -->
        <mxCell id="e4" value="🆕 Управление доступом: открытие домофона/шлагбаума, передача списков авторизованных лиц и номеров авто [REST, HTTPS, через API Gateway]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" edge="1" source="prop-system" target="smart-partner" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PropDevelopment → ЖКХ -->
        <mxCell id="e5" value="Получение данных о начислениях, передача платежей [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" source="prop-system" target="jkh" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PropDevelopment → Платёжная система -->
        <mxCell id="e6" value="Проведение онлайн-платежей за ЖКУ [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" source="prop-system" target="payment" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- PropDevelopment → Госорганы -->
        <mxCell id="e7" value="Регистрация сделок с недвижимостью [REST / СМЭВ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" source="prop-system" target="gov" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
